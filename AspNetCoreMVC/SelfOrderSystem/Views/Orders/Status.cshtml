@using SelfOrderSystem.Models
@model SelfOrderSystem.Models.Order
@{
    ViewData["Title"] = "注文状況";
}
<h1 class="h3">注文 #@Model.Id</h1>
<p>テーブル @Model.TableNumber</p>
<div class="alert alert-dark fs-4 fw-bold">
    現在：@Model.Status.ToJapanese()
</div>
@foreach (var item in Model.Items) {
    <div class="d-flex justify-content-between border-bottom py-2">
        <span>@item.Product?.Name × @item.Quantity</span>
        <span>@item.LineTotal.ToString("N0") 円</span>
    </div>
}

@section Scripts {
    @* SignalR のブラウザ用ライブラリ *@
    <script src="~/js/signalr/dist/browser/signalr.min.js"></script>

    <script>
        const orderConnection = new signalR.HubConnectionBuilder()
                                    .withUrl("/staffOrdersHub")
                                    .withAutomaticReconnect()
                                    .build();

        // 現在表示している注文のグループに参加する
        const publicId = "@Model.PublicId";
        const joinOrder = () =>
            orderConnection.invoke("JoinOrder", publicId);
            // 店員による状態変更を受けたら再読込する
            orderConnection.on("OrderStatusChanged", () => {
                window.location.reload();
            });
        // 切断から復旧したらグループへ入り直す
        orderConnection.onreconnected(async () => {
            await joinOrder();
                window.location.reload();
            });
        orderConnection.start().then(joinOrder)
                            .catch(error => console.error("注文状況接続エラー", error));
    </script>
}