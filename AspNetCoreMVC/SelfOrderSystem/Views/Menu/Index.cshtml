@*Controllerから受け取るデータの型*@
@model SelfOrderSystem.ViewModels.MenuViewModel

@{
    ViewData["Title"] = "メニュー";
}

<h1 class="h3 mb-3">メニュー</h1>
<div class="d-flex gap-2 overflow-auto pb-3">
    <a class="btn @(Model.SelectedCategoryId == null ? "btn-dark" : "btn-outline-dark")"
       asp-action="Index">
        すべて
    </a>
    @foreach (var category in Model.Categories) {
        <a class="btn @(Model.SelectedCategoryId == category.Id ? "btn-dark" : "btn-outline-dark")"
           asp-action="Index"
           asp-route-categoryId="@category.Id">
            @category.Name
        </a>
    }
</div>

@* 商品一覧より上へ追加する：CartController から渡されたエラーがあれば表示する *@
@if (TempData["Error"] is string errorMessage) {
    <div class="alert alert-danger">@errorMessage</div>
}


<div class="row g-4">
    @* 左側商品一覧 *@
    <div class="col-12 col-lg-9">
        <div class="row g-3">
            @foreach (var product in Model.Products) {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 shadow-sm">

                        @if (!string.IsNullOrWhiteSpace(product.ImagePath)) {
                            <img src="@Url.Content(product.ImagePath)"
                                 class="so-product-photo"
                                 alt="@product.Name"
                                 loading="lazy" />
                        } else {
                            <div class="so-product-photo so-product-photo--empty">
                                写真準備中
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h2 class="h5">@product.Name</h2>
                            <p class="text-muted flex-grow-1">@product.Description</p>
                            <p class="fs-5 fw-bold">@product.Price.ToString("N0") 円</p>
                            @* @if (product.IsSoldOut) {
                        <span class="badge text-bg-secondary">売り切れ</span>
                    } *@

                            <form asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="productId" value="@product.Id" />
                                @if (product.IsSoldOut) {
                                    <button class="btn btn-secondary w-100" disabled>
                                        売り切れ
                                    </button>
                                } else {
                                    <button class="btn btn-primary w-100" type="submit">
                                        カートに追加
                                    </button>
                                }
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @* 右側 カード概要 *@

    @* 右側 カートの商品一覧 *@
    <div class="col-12 col-lg-3">

        <aside class="card so-cart-sidebar">
            <div class="card-body">

                <h2 class="h5">
                    ご注文カート
                </h2>

                @* カートが空の場合 *@
                @if (Model.CartItems.Count == 0) {
                    <p class="text-muted">
                        カートは空です
                    </p>
                } else {
                    @* カート内の商品を表示 *@
                    @foreach (var item in Model.CartItems) {
                        <div class="so-cart-item">

                            @* 商品写真 *@
                            @if (!string.IsNullOrWhiteSpace(item.ImagePath)) {
                                <img src="@Url.Content(item.ImagePath)"
                                     alt="@item.ProductName"
                                     class="so-cart-photo"
                                     loading="lazy" />
                            } else {
                                <div class="so-cart-photo-empty">
                                    写真なし
                                </div>
                            }

                            @* 商品情報 *@
                            <div class="so-cart-info">

                                <strong>
                                    @item.ProductName
                                </strong>

                                <small>
                                    @item.UnitPrice.ToString("N0") 円
                                    × @item.Quantity
                                </small>

                                <span class="fw-bold">
                                    @item.LineTotal.ToString("N0") 円
                                </span>

                            </div>
                        </div>
                    }

                    @* 合計金額 *@
                    <div class="so-cart-total">
                        <span>
                            合計 @Model.CartItemCount 点
                        </span>
                        <strong>
                            @Model.CartTotal.ToString("N0") 円
                        </strong>
                    </div>
                }

                @* カート画面へのリンク *@
                <a asp-controller="Cart"
                   asp-action="Index"
                   class="btn btn-primary w-100 mt-3">
                    カートを確認する
                </a>

            </div>
        </aside>

    </div>

</div>
