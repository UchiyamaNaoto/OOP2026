@* カート画面はSession から取り出したCartItem 一覧を受け取る *@
@model List<SelfOrderSystem.Models.CartItem>

@{
    ViewData["Title"] = "カート";
    var total = Model.Sum(x => x.LineTotal); // 画面表示用に合計金額を計算する
}


<h1 class="h3 mb-3">カート</h1>
@* カートが空なら商品一覧へ戻る案内を表示する *@
@if (Model.Count == 0) {
    <div class="alert alert-info">カートは空です</div>
    <a class="btn btn-primary" asp-controller="Menu" asp-action="Index">メニューへ戻る</a>
} else {
    @* カート内の商品を1 件ずつ表示する *@
    @foreach (var item in Model) {
        <div class="card mb-2">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <strong>@item.ProductName</strong><br />
                        @item.UnitPrice.ToString("N0") 円 × @item.Quantity
                    </div>
                    <strong>@item.LineTotal.ToString("N0") 円</strong>
                </div>
                <div class="d-flex gap-2 mt-2">
                    @* 数量変更はproductId とquantity をUpdate へPOST する *@
                    <form asp-action="Update" method="post" class="d-flex gap-2">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <input class="form-control" type="number" name="quantity"
                               min="1" max="99" value="@item.Quantity" />
                        <button class="btn btn-outline-primary" type="submit">変更</button>
                    </form>
                    @* 削除はproductId をRemove へPOST する *@
                    <form asp-action="Remove" method="post">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <button class="btn btn-outline-danger" type="submit">削除</button>
                    </form>
                </div>
            </div>
        </div>
    }
    <div class="text-end fs-4 fw-bold my-3">
        合計 @total.ToString("N0") 円
    </div>
}