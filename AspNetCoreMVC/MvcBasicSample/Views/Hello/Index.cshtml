@*このViewがProduct型を受け取る宣言*@
@model List<MvcBasicSample.Models.Product>;

@{
    ViewData["Title"] = "商品一覧";    //タブ用のタイトル
}

<h1>商品一覧</h1>   @*画面内の見出し*@

@* Tag Helper で移動先を指定しBootstrap で見た目を整える *@
<a asp-controller="Hello" asp-action="Index"
   class="btn btn-primary mb-3">商品一覧を表示</a>

@* 件数が0 なら説明だけを表示する *@
@if(Model.Count == 0)
{
    <p>商品はありません</p>
}
else
{
    <p>@Model.Count 件の商品があります</p>
    <div class="row">
        @foreach (var product in Model) {
            @* 狭い画面では1 列で中程度以上の画面では2 列にする *@
            <div class="col-12 col-md-6 mb-3">
                <h2 class="h5">@product.Name</h2>
                <p>@product.Price 円</p>
            </div>
        }
    </div>
}
